<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:AmfibiaShop.Views.Controls">

    <!-- ===================== ЦВЕТА (тёмная тема сайта AMFIBIA) ===================== -->
    <Color x:Key="C.Bg">#0B0B0C</Color>
    <Color x:Key="C.Surface">#131315</Color>
    <Color x:Key="C.Surface2">#1A1A1D</Color>
    <Color x:Key="C.Surface3">#232327</Color>
    <Color x:Key="C.Line">#2A2A2F</Color>
    <Color x:Key="C.LineStrong">#3B3B42</Color>
    <Color x:Key="C.Text">#EDE6DA</Color>
    <Color x:Key="C.TextSoft">#C9C2B6</Color>
    <Color x:Key="C.Muted">#8A857D</Color>
    <Color x:Key="C.Accent">#D9707F</Color>
    <Color x:Key="C.AccentHover">#E8909C</Color>
    <Color x:Key="C.AccentDeep">#5A0F1C</Color>
    <Color x:Key="C.Gold">#C9A227</Color>
    <Color x:Key="C.Success">#7FC79B</Color>
    <Color x:Key="C.Error">#F0838F</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource C.Surface2}"/>
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource C.Surface3}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource C.LineStrong}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="TextSoft" Color="{StaticResource C.TextSoft}"/>
    <SolidColorBrush x:Key="Muted" Color="{StaticResource C.Muted}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource C.AccentHover}"/>
    <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource C.AccentDeep}"/>
    <SolidColorBrush x:Key="Gold" Color="{StaticResource C.Gold}"/>
    <SolidColorBrush x:Key="Success" Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="Error" Color="{StaticResource C.Error}"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#26D9707F"/>
    <SolidColorBrush x:Key="Overlay" Color="#CC0B0B0C"/>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C1114" Offset="0"/>
        <GradientStop Color="#0B0B0C" Offset="0.55"/>
        <GradientStop Color="#120D0F" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===================== ШРИФТЫ САЙТА ===================== -->
    <FontFamily x:Key="FontLogo">pack://application:,,,/Fonts/#UnifrakturMaguntia</FontFamily>
    <FontFamily x:Key="FontDisplay">pack://application:,,,/Fonts/#Cormorant Garamond SemiBold</FontFamily>
    <FontFamily x:Key="FontDisplayBold">pack://application:,,,/Fonts/#Cormorant Garamond Bold</FontFamily>
    <FontFamily x:Key="FontDisplayItalic">pack://application:,,,/Fonts/#Cormorant Garamond Medium</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontMedium">pack://application:,,,/Fonts/#Inter Medium</FontFamily>
    <FontFamily x:Key="FontSemi">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>

    <!-- Шрифты брендов (ключи из палитр сайта) -->
    <FontFamily x:Key="BrandFont.grotesk">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="BrandFont.grotesk-heavy">Arial Black</FontFamily>
    <FontFamily x:Key="BrandFont.serif">pack://application:,,,/Fonts/#Cormorant Garamond Bold</FontFamily>
    <FontFamily x:Key="BrandFont.serif-light">pack://application:,,,/Fonts/#Cormorant Garamond Medium</FontFamily>
    <FontFamily x:Key="BrandFont.serif-italic">pack://application:,,,/Fonts/#Cormorant Garamond Medium</FontFamily>
    <FontFamily x:Key="BrandFont.didone">pack://application:,,,/Fonts/#Cormorant Garamond Bold</FontFamily>
    <FontFamily x:Key="BrandFont.roman">pack://application:,,,/Fonts/#Cormorant Garamond SemiBold</FontFamily>
    <FontFamily x:Key="BrandFont.sans-light">pack://application:,,,/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="BrandFont.geometric">pack://application:,,,/Fonts/#Inter SemiBold</FontFamily>
    <FontFamily x:Key="BrandFont.futura">Arial Black</FontFamily>
    <FontFamily x:Key="BrandFont.gothic">pack://application:,,,/Fonts/#UnifrakturMaguntia</FontFamily>
    <FontFamily x:Key="BrandFont.hand">Segoe Script</FontFamily>
    <FontFamily x:Key="BrandFont.mono">Consolas</FontFamily>

    <!-- ===================== ТЕКСТ ===================== -->
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="44"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock" BasedOn="{StaticResource T.H1}">
        <Setter Property="FontSize" Value="32"/>
    </Style>
    <Style x:Key="T.H3" TargetType="TextBlock" BasedOn="{StaticResource T.H1}">
        <Setter Property="FontSize" Value="23"/>
    </Style>
    <Style x:Key="T.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>
    <Style x:Key="T.Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="T.Error" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Error}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="T.Price" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>

    <!-- ===================== ПАНЕЛИ ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="24"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Line}"/>
        <Setter Property="Margin" Value="0,16"/>
    </Style>

    <!-- ===================== КНОПКИ ===================== -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="20,11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Text}"/>
        <Setter Property="Foreground" Value="{StaticResource Bg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Bg}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Text}"/>
                <Setter Property="Background" Value="{StaticResource Surface3}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface3}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Сердечко на карточке товара -->
    <Style x:Key="Btn.Heart" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="#990B0B0C"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== НАВИГАЦИЯ В ШАПКЕ ===================== -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,26,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="0,10,0,12" VerticalAlignment="Center"/>
                        <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{StaticResource Accent}" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Счётчик-кружок -->
    <Style x:Key="CounterBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== ПОЛЯ ВВОДА ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}"
                                       Foreground="{StaticResource Muted}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Top" Padding="3,1,0,0"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Surface2}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== CHECKBOX ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="2" BorderThickness="1"
                                BorderBrush="{StaticResource LineStrong}" Background="{StaticResource Surface2}" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3.5,9 L7.5,13 L14.5,5" Stroke="{StaticResource Bg}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== RADIO: карточка варианта (доставка, оплата) ===================== -->
    <Style x:Key="Radio.Option" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource LineStrong}" StrokeThickness="1.5"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RADIO: «таблетка» (оценка, фильтры заказов) -->
    <Style x:Key="Radio.Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                            CornerRadius="16" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== СПИСКИ ===================== -->
    <!-- Списки без своей прокрутки: прокручивается вся страница, колесо мыши не «застревает» -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Список со своей прокруткой (заказы) -->
    <Style x:Key="List.Scroll" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка-переключатель (разделы каталога) -->
    <Style x:Key="Item.Row" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="10,7" CornerRadius="2" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- «Таблетка» (категории, размеры, пол) -->
    <Style x:Key="Item.Chip" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMedium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                            CornerRadius="2" Padding="12,6" MinWidth="44">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Text}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка с галочкой (бренды, множественный выбор) -->
    <Style x:Key="Item.Check" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="4,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="{StaticResource LineStrong}" Background="{StaticResource Surface2}" VerticalAlignment="Center">
                                <Path x:Name="Mark" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="{StaticResource Bg}" StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Text}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Цветной кружок (цвет товара) -->
    <Style x:Key="Item.Swatch" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Width="30" Height="30">
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                        <ContentPresenter Margin="4"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Muted}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Без подсветки (список заказов, карточки) -->
    <Style x:Key="Item.Plain" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="3" Padding="16,14" Margin="0,0,0,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== COMBOBOX ===================== -->
    <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="2">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                  Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Muted}" StrokeThickness="1.5"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12,9,32,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Template="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                                    CornerRadius="2" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" Margin="0,4"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="12,8">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface3}"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== ПОЛОСЫ ПРОКРУТКИ ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{StaticResource LineStrong}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Muted}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ПРОЧЕЕ ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Surface3}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style x:Key="Progress.Thin" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="Background" Value="{StaticResource Surface3}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="TemplateRoot">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Значок на карточке товара (новинка, скидка, ресейл, культовая модель) -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{StaticResource Text}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding BadgeKind}" Value="sale">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeKind}" Value="resale">
                <Setter Property="Background" Value="{StaticResource Gold}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding BadgeKind}" Value="iconic">
                <Setter Property="Background" Value="#E60B0B0C"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Bg}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding BadgeKind}" Value="iconic">
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Статус заказа -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Background" Value="#262C7FC79B"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="active">
                <Setter Property="Background" Value="#33D9707F"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="cancel">
                <Setter Property="Background" Value="#2A8A857D"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSemi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Success}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusKind}" Value="active">
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusKind}" Value="cancel">
                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ПРЕОБРАЗОВАТЕЛИ И ШАБЛОНЫ ===================== -->
    <c:HexBrushConverter x:Key="HexBrush"/>
    <c:GradientConverter x:Key="Gradient"/>
    <c:BrandFontConverter x:Key="BrandFont"/>
    <c:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
    <c:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

    <!-- Плитка модного дома: цвета и шрифт из палитры бренда на сайте -->
    <DataTemplate x:Key="BrandTile">
        <Button Cursor="Hand" Margin="0,0,14,14" FocusVisualStyle="{x:Null}" ToolTip="{Binding Name}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Tile" Height="150" CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource Line}" ClipToBounds="True">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource Gradient}">
                                <Binding Path="Bg"/>
                                <Binding Path="Bg2"/>
                            </MultiBinding>
                        </Border.Background>
                        <Grid Margin="20,16">
                            <TextBlock Text="{Binding Name}" FontFamily="{Binding FontKey, Converter={StaticResource BrandFont}}"
                                       FontSize="27" Foreground="{Binding Fg, Converter={StaticResource HexBrush}}"
                                       TextWrapping="Wrap" VerticalAlignment="Top" LineHeight="30"/>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" Opacity="0.72"/>
                                <TextBlock Text="{Binding ProductsText}" FontSize="12" FontFamily="{StaticResource FontSemi}"
                                           Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Height="3" Width="40" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                    Background="{Binding Accent, Converter={StaticResource HexBrush}}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- Сетка карточек товаров в 4 колонки -->
    <ItemsPanelTemplate x:Key="Grid4">
        <UniformGrid Columns="4"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Grid3">
        <UniformGrid Columns="3"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Grid5">
        <UniformGrid Columns="5"/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Wrap">
        <WrapPanel/>
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Row">
        <StackPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

    <DataTemplate x:Key="ProductCardTemplate">
        <c:ProductCard/>
    </DataTemplate>

    <!-- Заголовок раздела страницы: название + ссылка «Смотреть все» -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
</ResourceDictionary>
