<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AmfibiaShop</RootNamespace>
    <AssemblyName>AmfibiaShop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Каталог товаров сайта AMFIBIA встраивается внутрь программы -->
    <None Remove="Data\catalog.json" />
    <EmbeddedResource Include="Data\catalog.json" LogicalName="catalog.json" />
  </ItemGroup>

</Project>
