<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AmfibiaShop</RootNamespace>
    <AssemblyName>AmfibiaShop</AssemblyName>
    <Product>AMFIBIA — магазин (ЛР №28, MVP)</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Данные сайта AMFIBIA встраиваются внутрь программы -->
    <None Remove="Data\amfibia.json" />
    <EmbeddedResource Include="Data\amfibia.json" LogicalName="amfibia.json" />

    <!-- Шрифты сайта (лицензия SIL OFL, тексты лицензий лежат рядом) -->
    <None Remove="Fonts\*.ttf" />
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

</Project>
