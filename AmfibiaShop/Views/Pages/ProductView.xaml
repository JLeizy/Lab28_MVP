<UserControl x:Class="AmfibiaShop.Views.Pages.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaShop.Views.Controls">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Margin="44,30,40,48">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Рисунок товара -->
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                        <c:ProductArt Product="{Binding Product}" Height="620"/>
                        <StackPanel Orientation="Horizontal" Margin="18" VerticalAlignment="Top">
                            <Border Background="{StaticResource Accent}" CornerRadius="2" Padding="10,5"
                                    Visibility="{Binding DiscountText, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding DiscountText}" FontFamily="{StaticResource FontSemi}" FontSize="13" Foreground="{StaticResource Bg}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Информация и покупка -->
                <StackPanel Grid.Column="2">
                    <Button Content="{Binding Brand}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" FontSize="14"
                            Click="BrandButton_Click" ToolTip="Страница модного дома"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.H1}" FontSize="46" Margin="0,8,0,0" LineHeight="50"/>
                    <TextBlock Text="{Binding NameEn}" FontFamily="{StaticResource FontDisplayItalic}" FontStyle="Italic" FontSize="20"
                               Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding RatingText}" Foreground="{StaticResource Gold}" FontFamily="{StaticResource FontMedium}" FontSize="13" Margin="0,12,0,0"/>

                    <ItemsControl ItemsSource="{Binding Badges}" ItemsPanel="{StaticResource Wrap}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="2" Padding="10,4" Margin="0,0,8,8">
                                    <TextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource FontMedium}" Foreground="{StaticResource TextSoft}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Price}" FontFamily="{StaticResource FontDisplayBold}" FontSize="40" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="{Binding OldPrice}" FontSize="17" Foreground="{StaticResource Muted}" TextDecorations="Strikethrough"
                                   VerticalAlignment="Bottom" Margin="14,0,0,9"/>
                    </WrapPanel>

                    <!-- Цвета модели -->
                    <TextBlock Text="ЦВЕТ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,22,0,8"/>
                    <ListBox x:Name="VariantList" ItemContainerStyle="{StaticResource Item.Swatch}" ItemsPanel="{StaticResource Wrap}"
                             SelectionChanged="VariantList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Fill="{Binding Hex, Converter={StaticResource HexBrush}}" Stroke="{StaticResource LineStrong}" StrokeThickness="1"
                                         ToolTip="{Binding Color}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Размеры -->
                    <TextBlock Text="РАЗМЕР" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,14,0,10"/>
                    <ListBox x:Name="SizeList" ItemContainerStyle="{StaticResource Item.Chip}" ItemsPanel="{StaticResource Wrap}"/>
                    <TextBlock x:Name="SizeHint" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,2,0,0"/>

                    <!-- Количество и кнопки -->
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MinusButton" Content="−" Style="{StaticResource Btn.Icon}" Width="42" Tag="-1" Click="Quantity_Click"/>
                                <TextBlock x:Name="QuantityText" Text="1" Width="36" TextAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontSemi}" FontSize="15"/>
                                <Button x:Name="PlusButton" Content="+" Style="{StaticResource Btn.Icon}" Width="42" Tag="1" Click="Quantity_Click"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="AddToCartButton" Content="В корзину" Style="{StaticResource Btn.Primary}" Padding="34,13" Click="AddToCartButton_Click"/>
                        <Button x:Name="BuyNowButton" Content="Купить сейчас" Style="{StaticResource Btn.Accent}" Padding="24,13" Margin="10,0,0,0" Click="BuyNowButton_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="FavoriteButton" Content="♡  В избранное" Style="{StaticResource Btn.Ghost}" Click="FavoriteButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="CompareButton" Content="⇄  Сравнить" Style="{StaticResource Btn.Ghost}" Click="CompareButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>

                    <!-- Гарантии -->
                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,24,0,0">
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="✓ Подлинность" FontFamily="{StaticResource FontSemi}" FontSize="13"/>
                                <TextBlock Text="Каждая вещь проходит экспертизу" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="⇢ Доставка от 1 дня" FontFamily="{StaticResource FontSemi}" FontSize="13"/>
                                <TextBlock Text="Бесплатно от 3 000 BYN" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="↺ Возврат 14 дней" FontFamily="{StaticResource FontSemi}" FontSize="13"/>
                                <TextBlock Text="После получения заказа" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Описание и характеристики -->
            <Grid Margin="0,44,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Описание" Style="{StaticResource T.H2}"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="15" LineHeight="25" Margin="0,12,0,0"/>
                    <TextBlock Text="СОСТАВ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,24,0,6"/>
                    <TextBlock Text="{Binding Composition}" Style="{StaticResource T.Body}"/>
                    <TextBlock Text="УХОД" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,20,0,6"/>
                    <TextBlock Text="{Binding Care}" Style="{StaticResource T.Body}"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Характеристики" Style="{StaticResource T.H3}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Specs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" Width="130"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{StaticResource Text}" TextWrapping="Wrap" FontSize="13"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Отзывы -->
            <Grid Margin="0,48,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Отзывы" Style="{StaticResource T.H2}"/>
                    <TextBlock x:Name="ReviewsSummary" Foreground="{StaticResource Gold}" FontFamily="{StaticResource FontMedium}" Margin="0,6,0,16"/>
                    <ItemsControl x:Name="ReviewItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" Style="{StaticResource T.Muted}" FontSize="12"/>
                                            <TextBlock Text="{Binding Author}" FontFamily="{StaticResource FontSemi}" FontSize="14"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Stars}" Foreground="{StaticResource Gold}" FontFamily="Segoe UI Symbol" FontSize="14" Margin="0,4,0,8"/>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource T.Body}"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,8,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoReviewsText" Text="Станьте первым, кто оставит отзыв." Style="{StaticResource T.Muted}" Visibility="Collapsed"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel x:Name="ReviewForm">
                        <TextBlock Text="Ваш отзыв" Style="{StaticResource T.H3}"/>
                        <TextBlock x:Name="ReviewHint" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,6,0,14"/>
                        <TextBlock Text="Оценка" Style="{StaticResource T.Label}"/>
                        <WrapPanel x:Name="StarsPanel">
                            <RadioButton Content="★ 1" Style="{StaticResource Radio.Chip}" GroupName="Stars" Tag="1"/>
                            <RadioButton Content="★ 2" Style="{StaticResource Radio.Chip}" GroupName="Stars" Tag="2"/>
                            <RadioButton Content="★ 3" Style="{StaticResource Radio.Chip}" GroupName="Stars" Tag="3"/>
                            <RadioButton Content="★ 4" Style="{StaticResource Radio.Chip}" GroupName="Stars" Tag="4"/>
                            <RadioButton Content="★ 5" Style="{StaticResource Radio.Chip}" GroupName="Stars" Tag="5"/>
                        </WrapPanel>
                        <TextBlock Text="Текст" Style="{StaticResource T.Label}" Margin="0,8,0,6"/>
                        <TextBox x:Name="ReviewTextBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Tag="Как сидит, качество, доставка…"/>
                        <Button x:Name="SubmitReviewButton" Content="Отправить на модерацию" Style="{StaticResource Btn.Ghost}" Margin="0,14,0,0"
                                HorizontalAlignment="Left" Click="SubmitReviewButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Похожие вещи -->
            <TextBlock Text="Похожие вещи" Style="{StaticResource T.H2}" Margin="0,48,0,18"/>
            <ItemsControl x:Name="SimilarItems" ItemTemplate="{StaticResource ProductCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
