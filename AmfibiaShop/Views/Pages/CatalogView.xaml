<UserControl x:Class="AmfibiaShop.Views.Pages.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== ФИЛЬТРЫ ===================== -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,26,22,30">
                    <DockPanel Margin="0,0,0,18">
                        <Button x:Name="ResetButton" DockPanel.Dock="Right" Content="Сбросить" Style="{StaticResource Btn.Link}" Click="ResetButton_Click"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="Фильтры" Style="{StaticResource T.H3}"/>
                    </DockPanel>

                    <TextBox x:Name="SearchBox" Tag="Название, бренд или артикул" TextChanged="SearchBox_TextChanged"/>

                    <TextBlock Text="РАЗДЕЛ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,24,0,8"/>
                    <ListBox x:Name="GroupList" ItemContainerStyle="{StaticResource Item.Row}" SelectionChanged="GroupList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="КАТЕГОРИЯ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,22,0,10"/>
                    <ListBox x:Name="CategoryList" ItemContainerStyle="{StaticResource Item.Chip}" ItemsPanel="{StaticResource Wrap}"
                             SelectionChanged="Filter_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Subtitle}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="МОДНЫЙ ДОМ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,22,0,8"/>
                    <ListBox x:Name="BrandList" SelectionMode="Multiple" ItemContainerStyle="{StaticResource Item.Check}"
                             SelectionChanged="Filter_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="ДЛЯ КОГО" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,22,0,10"/>
                    <ListBox x:Name="GenderList" ItemContainerStyle="{StaticResource Item.Chip}" ItemsPanel="{StaticResource Wrap}"
                             SelectionChanged="Filter_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="ЦВЕТ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,16,0,10"/>
                    <ListBox x:Name="ColorList" SelectionMode="Multiple" ItemContainerStyle="{StaticResource Item.Swatch}"
                             ItemsPanel="{StaticResource Wrap}" SelectionChanged="Filter_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Ellipse ToolTip="{Binding Title}" Stroke="{StaticResource LineStrong}" StrokeThickness="1">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{Binding Extra, Converter={StaticResource HexBrush}}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Extra}" Value="">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#B3122E" Offset="0"/>
                                                                <GradientStop Color="#F2D21B" Offset="0.5"/>
                                                                <GradientStop Color="#3557A0" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="PriceLabel" Text="ЦЕНА" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,16,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MinPriceBox" Tag="от" LostFocus="Price_LostFocus" KeyDown="Price_KeyDown"/>
                        <TextBox x:Name="MaxPriceBox" Grid.Column="2" Tag="до" LostFocus="Price_LostFocus" KeyDown="Price_KeyDown"/>
                    </Grid>
                    <TextBlock x:Name="PriceError" Style="{StaticResource T.Error}"/>

                    <StackPanel Margin="0,22,0,0">
                        <CheckBox x:Name="OnlyNewBox" Content="Только новинки" Margin="0,0,0,12" Checked="Check_Changed" Unchecked="Check_Changed"/>
                        <CheckBox x:Name="OnlySaleBox" Content="Со скидкой" Margin="0,0,0,12" Checked="Check_Changed" Unchecked="Check_Changed"/>
                        <CheckBox x:Name="OnlyPreownedBox" Content="Ресейл с экспертизой" Margin="0,0,0,12" Checked="Check_Changed" Unchecked="Check_Changed"/>
                        <CheckBox x:Name="OnlyIconicBox" Content="Культовые модели" Checked="Check_Changed" Unchecked="Check_Changed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== РЕЗУЛЬТАТЫ ===================== -->
        <DockPanel Grid.Column="1" Margin="36,26,20,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,16,20">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Сортировка" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="SortBox" Width="210" SelectionChanged="Filter_SelectionChanged"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Каталог" Style="{StaticResource T.H1}" FontSize="40"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <StackPanel x:Name="PagerPanel" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,18"/>

            <ScrollViewer x:Name="ProductsScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ProductsItems" ItemsPanel="{StaticResource Grid4}" ItemTemplate="{StaticResource ProductCardTemplate}"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
