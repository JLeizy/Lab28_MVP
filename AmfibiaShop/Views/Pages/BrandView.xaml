<UserControl x:Class="AmfibiaShop.Views.Pages.BrandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Margin="40,30,40,48">
            <!-- Шапка в цветах бренда -->
            <Border CornerRadius="4" ClipToBounds="True" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="52,46">
                <Border.Background>
                    <MultiBinding Converter="{StaticResource Gradient}">
                        <Binding Path="Bg"/>
                        <Binding Path="Bg2"/>
                    </MultiBinding>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Tagline}" FontFamily="{StaticResource FontSemi}" FontSize="12"
                                   Foreground="{Binding Accent, Converter={StaticResource HexBrush}}"/>
                        <TextBlock Text="{Binding Name}" FontFamily="{Binding FontKey, Converter={StaticResource BrandFont}}" FontSize="74"
                                   Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" TextWrapping="Wrap" LineHeight="82" Margin="0,8,0,16"/>
                        <TextBlock Text="{Binding Description}" FontSize="15" LineHeight="25" TextWrapping="Wrap" MaxWidth="680" HorizontalAlignment="Left"
                                   Foreground="{Binding Fg, Converter={StaticResource HexBrush}}" Opacity="0.85"/>
                        <Button Content="{Binding ProductsText}" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left" Margin="0,28,0,0"
                                Click="AllProducts_Click"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#55000000" CornerRadius="3" Padding="24,20" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontFamily="{StaticResource FontSemi}" Foreground="#B3EDE6DA"/>
                                        <TextBlock Text="{Binding Value}" FontSize="15" Foreground="#EDE6DA" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,44,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- История -->
                <StackPanel>
                    <TextBlock Text="История дома" Style="{StaticResource T.H2}" Margin="0,0,0,20"/>
                    <ItemsControl ItemsSource="{Binding Timeline}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Year}" FontFamily="{StaticResource FontDisplayBold}" FontSize="27"
                                               Foreground="{StaticResource Accent}" Margin="0,0,0,0"/>
                                    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="22,4,0,22">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontSemi}" FontSize="15"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Коллекции -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Коллекции" Style="{StaticResource T.H2}" Margin="0,0,0,20"/>
                    <ItemsControl ItemsSource="{Binding Collections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="{StaticResource Accent}" CornerRadius="2" Padding="7,2"
                                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top">
                                                <TextBlock Text="НОВАЯ" FontSize="10" FontFamily="{StaticResource FontSemi}" Foreground="{StaticResource Bg}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" FontSize="22"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Креативные директора -->
            <TextBlock Text="Креативные директора" Style="{StaticResource T.H2}" Margin="0,40,0,20"/>
            <ItemsControl ItemsSource="{Binding Directors}" ItemsPanel="{StaticResource Grid3}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,16,16" Padding="22,20">
                            <StackPanel>
                                <TextBlock Text="{Binding Period}" FontFamily="{StaticResource FontSemi}" FontSize="12" Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" Margin="0,6,0,8"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Body}" FontSize="13" LineHeight="20"/>
                                <TextBlock Text="{Binding KeyWorks}" FontFamily="{StaticResource FontDisplayItalic}" FontStyle="Italic" FontSize="15"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Вещи бренда -->
            <DockPanel Margin="0,28,16,18">
                <Button DockPanel.Dock="Right" Content="Все вещи бренда →" Style="{StaticResource Btn.Link}" Click="AllProducts_Click" VerticalAlignment="Bottom"/>
                <TextBlock Text="Вещи в каталоге" Style="{StaticResource T.H2}"/>
            </DockPanel>
            <ItemsControl x:Name="ProductItems" ItemsPanel="{StaticResource Grid4}" ItemTemplate="{StaticResource ProductCardTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
