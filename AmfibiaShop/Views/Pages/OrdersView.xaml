<UserControl x:Class="AmfibiaShop.Views.Pages.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaShop.Views.Controls">
    <Grid Margin="44,30,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="36"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список заказов -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="ИСТОРИЯ ПОКУПОК" Style="{StaticResource T.Eyebrow}"/>
                <TextBlock Text="Мои заказы" Style="{StaticResource T.H1}" Margin="0,6,0,4"/>
                <TextBlock x:Name="CountText" Style="{StaticResource T.Muted}" Margin="0,0,0,16"/>
                <WrapPanel x:Name="FilterPanel" Margin="0,0,0,10"/>
            </StackPanel>
            <ListBox x:Name="OrderList" Style="{StaticResource List.Scroll}" ItemContainerStyle="{StaticResource Item.Plain}"
                     SelectionChanged="OrderList_SelectionChanged" Margin="0,0,0,20">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Number}" FontFamily="{StaticResource FontSemi}" FontSize="14" Foreground="{StaticResource Text}"/>
                                <TextBlock Style="{StaticResource T.Muted}" FontSize="12" Margin="0,3,0,8">
                                    <Run Text="{Binding Date, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ItemsText, Mode=OneWay}"/>
                                </TextBlock>
                                <Border Style="{StaticResource StatusPill}">
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Total}" Style="{StaticResource T.Price}" VerticalAlignment="Top"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Подробности -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,40">
                <Border x:Name="DetailsPanel" Style="{StaticResource Card}" Padding="32,28">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" VerticalAlignment="Top" Padding="14,5">
                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" FontSize="13"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Number}" Style="{StaticResource T.H2}"/>
                                <TextBlock Style="{StaticResource T.Muted}" Margin="0,4,0,0">
                                    <Run Text="Оформлен "/><Run Text="{Binding Date, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding StatusHelp}" Style="{StaticResource T.Body}" Margin="0,16,0,0"/>

                        <!-- Шкала статусов -->
                        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,24,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,6,0">
                                        <Grid Height="22">
                                            <Border x:Name="Line" Height="2" Background="{StaticResource LineStrong}" VerticalAlignment="Center"/>
                                            <Ellipse x:Name="Dot" Width="16" Height="16" HorizontalAlignment="Left" Fill="{StaticResource Surface3}"
                                                     Stroke="{StaticResource LineStrong}" StrokeThickness="2"/>
                                        </Grid>
                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12" FontFamily="{StaticResource FontMedium}"
                                                   Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,8,0"/>
                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,8,0"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="done">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="Line" Property="Background" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Text}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="current">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Text}"/>
                                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Accent}"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Text}"/>
                                            <Setter TargetName="Title" Property="FontFamily" Value="{StaticResource FontSemi}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="cancelled">
                                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Muted}"/>
                                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource Muted}"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Error}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" Margin="0,24"/>

                        <!-- Товары -->
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="76" CornerRadius="2" ClipToBounds="True">
                                            <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,6,12,0">
                                            <Button Content="{Binding Name}" Style="{StaticResource Btn.Link}" Foreground="{StaticResource Text}"
                                                    FontFamily="{StaticResource FontMedium}" FontSize="14" HorizontalAlignment="Left"
                                                    Tag="{Binding Id}" Click="Product_Click"/>
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Total}" Style="{StaticResource T.Price}" FontSize="15" Margin="0,6,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Divider}" Margin="0,12,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding Info}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" Width="110"/>
                                            <TextBlock Text="{Binding Value}" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Товары" Style="{StaticResource T.Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Subtotal}"/>
                                <TextBlock Grid.Row="1" Text="Скидка" Style="{StaticResource T.Muted}" Margin="0,6,0,0"
                                           Visibility="{Binding Discount, Converter={StaticResource EmptyToCollapsed}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Discount}" Foreground="{StaticResource Accent}" Margin="0,6,0,0"
                                           Visibility="{Binding Discount, Converter={StaticResource EmptyToCollapsed}}"/>
                                <TextBlock Grid.Row="2" Text="Доставка" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Delivery}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Text="Итого" FontFamily="{StaticResource FontDisplayBold}" FontSize="24" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Total}" FontFamily="{StaticResource FontDisplayBold}" FontSize="24" Margin="0,10,0,0"/>
                            </Grid>
                        </Grid>

                        <WrapPanel Margin="0,24,0,0">
                            <Button x:Name="CancelButton" Content="Отменить заказ" Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" Click="CancelButton_Click"/>
                            <Button x:Name="ReturnButton" Content="Оформить возврат" Style="{StaticResource Btn.Ghost}" Margin="0,0,10,0"
                                    Visibility="{Binding CanReturn, Converter={StaticResource BoolToVisibility}}" Click="ReturnButton_Click"/>
                            <Button x:Name="RepeatButton" Content="Повторить заказ" Style="{StaticResource Btn.Primary}" Click="RepeatButton_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="40,56" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Здесь появятся ваши заказы" Style="{StaticResource T.H2}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выберите другой фильтр или оформите первый заказ." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
