<UserControl x:Class="AmfibiaShop.Views.Pages.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="44,30,44,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Карточка покупателя -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28,32">
                <StackPanel>
                    <Border Width="104" Height="104" CornerRadius="52" Background="{StaticResource AccentDeep}" BorderBrush="{StaticResource Accent}"
                            BorderThickness="1" HorizontalAlignment="Center">
                        <TextBlock x:Name="InitialsText" FontFamily="{StaticResource FontDisplayBold}" FontSize="42" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="NameText" Style="{StaticResource T.H2}" FontSize="28" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,2"/>
                    <TextBlock x:Name="EmailText" Style="{StaticResource T.Muted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RoleText" Foreground="{StaticResource Accent}" FontFamily="{StaticResource FontSemi}" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="SinceText" Style="{StaticResource T.Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>

                    <ItemsControl x:Name="StatsItems" Margin="0,24,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2}" CornerRadius="3" Margin="4" Padding="12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource FontDisplayBold}" FontSize="20" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource T.Muted}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="LogoutButton" Content="Выйти из аккаунта" Style="{StaticResource Btn.Ghost}" Margin="0,24,0,0" Click="LogoutButton_Click"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2">
                <!-- Личные данные -->
                <Border Style="{StaticResource Card}" Padding="32,28">
                    <StackPanel>
                        <TextBlock Text="Личные данные и адрес" Style="{StaticResource T.H2}" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Имя" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="FirstNameBox"/>
                                <TextBlock x:Name="FirstNameError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Фамилия" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="LastNameBox"/>
                                <TextBlock x:Name="LastNameError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                <TextBlock Text="Телефон" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="PhoneBox"/>
                                <TextBlock x:Name="PhoneError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Email (логин, изменить нельзя)" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="EmailBox" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="Город" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="CityBox"/>
                                <TextBlock x:Name="CityError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Улица" Style="{StaticResource T.Label}"/>
                                <TextBox x:Name="StreetBox"/>
                            </StackPanel>
                            <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Дом" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="HouseBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Квартира" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="ApartmentBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Индекс" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="PostalBox"/>
                                    <TextBlock x:Name="PostalError" Style="{StaticResource T.Error}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Button x:Name="SaveButton" Content="Сохранить изменения" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left"
                                Margin="0,22,0,0" Click="SaveButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Пароль -->
                <Border Style="{StaticResource Card}" Padding="32,28" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Смена пароля" Style="{StaticResource T.H2}" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Текущий пароль" Style="{StaticResource T.Label}"/>
                                <PasswordBox x:Name="CurrentPasswordBox"/>
                                <TextBlock x:Name="CurrentPasswordError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Новый пароль" Style="{StaticResource T.Label}"/>
                                <PasswordBox x:Name="NewPasswordBox"/>
                                <TextBlock x:Name="NewPasswordError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Повторите пароль" Style="{StaticResource T.Label}"/>
                                <PasswordBox x:Name="RepeatPasswordBox"/>
                                <TextBlock x:Name="RepeatPasswordError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="ChangePasswordButton" Content="Изменить пароль" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left"
                                Margin="0,22,0,0" Click="ChangePasswordButton_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
