<UserControl x:Class="AmfibiaShop.Views.Pages.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,30,44,48" MaxWidth="860" HorizontalAlignment="Center" Width="860">
            <StackPanel x:Name="FormPanel">
                <TextBlock Text="ОФОРМЛЕНИЕ ЗАКАЗА" Style="{StaticResource T.Eyebrow}"/>
                <TextBlock Text="Почти готово" Style="{StaticResource T.H1}" Margin="0,6,0,24"/>

                <!-- Шаги -->
                <StackPanel x:Name="StepsPanel" Orientation="Horizontal" Margin="0,0,0,28"/>

                <Border Style="{StaticResource Card}" Padding="32,28">
                    <Grid>
                        <!-- Шаг 1. Получатель -->
                        <StackPanel x:Name="Step1">
                            <TextBlock Text="Получатель" Style="{StaticResource T.H2}" Margin="0,0,0,18"/>
                            <TextBlock Text="Имя и фамилия" Style="{StaticResource T.Label}"/>
                            <TextBox x:Name="CustomerBox"/>
                            <TextBlock x:Name="CustomerError" Style="{StaticResource T.Error}"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Телефон" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="PhoneBox" Tag="+375 29 123-45-67"/>
                                    <TextBlock x:Name="PhoneError" Style="{StaticResource T.Error}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email для чека и трек-номера" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="EmailBox"/>
                                    <TextBlock x:Name="EmailError" Style="{StaticResource T.Error}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Шаг 2. Доставка -->
                        <StackPanel x:Name="Step2" Visibility="Collapsed">
                            <TextBlock Text="Доставка" Style="{StaticResource T.H2}" Margin="0,0,0,18"/>
                            <StackPanel x:Name="DeliveryPanel"/>
                            <TextBlock x:Name="DeliveryError" Style="{StaticResource T.Error}"/>
                            <TextBlock Text="Город" Style="{StaticResource T.Label}" Margin="0,14,0,6"/>
                            <TextBox x:Name="CityBox" TextChanged="CityBox_TextChanged"/>
                            <TextBlock x:Name="CityError" Style="{StaticResource T.Error}"/>
                            <Grid x:Name="CourierPanel" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Улица" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="StreetBox"/>
                                    <TextBlock x:Name="StreetError" Style="{StaticResource T.Error}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Дом" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="HouseBox"/>
                                    <TextBlock x:Name="HouseError" Style="{StaticResource T.Error}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Квартира" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="ApartmentBox"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="PickupPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock Text="Пункт выдачи" Style="{StaticResource T.Label}"/>
                                <ComboBox x:Name="PickupBox"/>
                                <TextBlock x:Name="PickupPointError" Style="{StaticResource T.Error}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Шаг 3. Оплата -->
                        <StackPanel x:Name="Step3" Visibility="Collapsed">
                            <TextBlock Text="Оплата" Style="{StaticResource T.H2}" Margin="0,0,0,18"/>
                            <StackPanel x:Name="PaymentPanel"/>
                            <TextBlock x:Name="PaymentError" Style="{StaticResource T.Error}"/>
                            <Border x:Name="CardPanel" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="3" Padding="22,18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Номер карты" Style="{StaticResource T.Label}"/>
                                    <TextBox x:Name="CardNumberBox" Tag="4242 4242 4242 4242" MaxLength="19"/>
                                    <TextBlock x:Name="CardNumberError" Style="{StaticResource T.Error}"/>
                                    <TextBlock Text="Имя владельца (латиницей)" Style="{StaticResource T.Label}" Margin="0,12,0,6"/>
                                    <TextBox x:Name="CardHolderBox" Tag="EVA LISOVSKAYA" CharacterCasing="Upper"/>
                                    <TextBlock x:Name="CardHolderError" Style="{StaticResource T.Error}"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Срок действия" Style="{StaticResource T.Label}"/>
                                            <TextBox x:Name="CardExpiryBox" Tag="ММ/ГГ" MaxLength="5"/>
                                            <TextBlock x:Name="CardExpiryError" Style="{StaticResource T.Error}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="CVC" Style="{StaticResource T.Label}"/>
                                            <TextBox x:Name="CardCvcBox" Tag="123" MaxLength="3"/>
                                            <TextBlock x:Name="CardCvcError" Style="{StaticResource T.Error}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Тестовая карта сайта: 4242 4242 4242 4242, любой будущий срок и CVC." Style="{StaticResource T.Muted}"
                                               FontSize="12" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Шаг 4. Подтверждение -->
                        <StackPanel x:Name="Step4" Visibility="Collapsed">
                            <TextBlock Text="Проверьте заказ" Style="{StaticResource T.H2}" Margin="0,0,0,18"/>
                            <ItemsControl x:Name="SummaryRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Muted}" Width="140"/>
                                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="ТОВАРЫ" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource Muted}" Margin="0,20,0,8"/>
                            <ItemsControl x:Name="SummaryItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Body}" Margin="0,0,0,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Товары" Style="{StaticResource T.Muted}"/>
                                <TextBlock x:Name="SumSubtotal" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Text="Скидка" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SumDiscount" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Text="Доставка" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="SumDelivery" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="3" Text="Итого" FontFamily="{StaticResource FontDisplayBold}" FontSize="28" Margin="0,12,0,0"/>
                                <TextBlock x:Name="SumTotal" Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource FontDisplayBold}" FontSize="28" Margin="0,12,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="ErrorPanel" Background="#22F0838F" BorderBrush="#55F0838F" BorderThickness="1" CornerRadius="2"
                        Padding="14,10" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Error}" TextWrapping="Wrap"/>
                </Border>

                <DockPanel Margin="0,22,0,0">
                    <Button x:Name="PrevButton" DockPanel.Dock="Left" Content="← Назад" Style="{StaticResource Btn.Ghost}" Click="PrevButton_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="NextButton" Content="Далее →" Style="{StaticResource Btn.Primary}" Padding="30,12" Click="NextButton_Click"/>
                        <Button x:Name="ConfirmButton" Content="Подтвердить заказ" Style="{StaticResource Btn.Accent}" Padding="30,12"
                                Visibility="Collapsed" Click="ConfirmButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Заказ оформлен -->
            <Border x:Name="SuccessPanel" Style="{StaticResource Card}" Padding="48,52" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38" Background="{StaticResource AccentDeep}" HorizontalAlignment="Center">
                        <TextBlock Text="✓" FontSize="38" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Спасибо за заказ!" Style="{StaticResource T.H1}" HorizontalAlignment="Center" Margin="0,20,0,6"/>
                    <TextBlock x:Name="SuccessNumber" FontFamily="{StaticResource FontSemi}" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SuccessDetails" Style="{StaticResource T.Body}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="540" Margin="0,14,0,0"/>
                    <TextBlock x:Name="SuccessNote" Foreground="{StaticResource Gold}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="540"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Button x:Name="OrdersButton" Content="Мои заказы" Style="{StaticResource Btn.Primary}" Margin="0,0,12,0" Click="OrdersButton_Click"/>
                        <Button Content="Продолжить покупки" Style="{StaticResource Btn.Ghost}" Click="CatalogButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
