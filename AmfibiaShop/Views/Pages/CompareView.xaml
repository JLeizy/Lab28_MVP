<UserControl x:Class="AmfibiaShop.Views.Pages.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaShop.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="44,30,40,48">
            <DockPanel Margin="0,0,0,26">
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Очистить сравнение" Style="{StaticResource Btn.Ghost}"
                        VerticalAlignment="Bottom" Click="ClearButton_Click"/>
                <StackPanel>
                    <TextBlock Text="ДО 4 ВЕЩЕЙ РЯДОМ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Сравнение" Style="{StaticResource T.H1}" Margin="0,6,0,4"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource T.Muted}"/>
                </StackPanel>
            </DockPanel>

            <StackPanel x:Name="TablePanel" Orientation="Horizontal">
                <!-- Названия строк -->
                <StackPanel Width="150">
                    <Border Height="392"/>
                    <ItemsControl x:Name="RowTitles">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="52" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Столбцы-товары -->
                <ItemsControl x:Name="Columns" ItemsPanel="{StaticResource Row}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="280" Margin="0,0,16,0">
                                <Border Height="376" Margin="0,0,0,16" Style="{StaticResource Card}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="230"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <c:ProductArt Product="{Binding Product}"/>
                                        <Border Background="{StaticResource Gold}" CornerRadius="2" Padding="8,3" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Visibility="{Binding IsBestPrice, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Лучшая цена" FontSize="11" FontFamily="{StaticResource FontSemi}" Foreground="{StaticResource Bg}"/>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="16,12,16,14">
                                            <TextBlock Text="{Binding Brand}" FontFamily="{StaticResource FontSemi}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMedium}" FontSize="14" Height="40" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" Margin="0,4,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Открыть" Style="{StaticResource Btn.Ghost}" Padding="12,6" Tag="{Binding Id}" Click="Open_Click"/>
                                                <Button Content="✕ Убрать" Style="{StaticResource Btn.Link}" Margin="14,0,0,0" Tag="{Binding Id}" Click="Remove_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Values}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="52" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,10,0">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="40,56" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⇄" FontFamily="Segoe UI Symbol" FontSize="58" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Сравнивать пока нечего" Style="{StaticResource T.H2}" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                    <TextBlock Text="Откройте товар и нажмите «Сравнить» — до четырёх вещей рядом." Style="{StaticResource T.Muted}" HorizontalAlignment="Center"/>
                    <Button Content="Перейти в каталог" Style="{StaticResource Btn.Primary}" Margin="0,24,0,0" HorizontalAlignment="Center" Click="Catalog_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
