<UserControl x:Class="AmfibiaShop.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32,24,48">

            <!-- Витрина -->
            <Border Background="{StaticResource HeroGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="4" ClipToBounds="True" Padding="52,46" Margin="0,0,16,44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="AMFIBIA" FontFamily="{StaticResource FontLogo}" FontSize="230" Opacity="0.045"
                               Foreground="{StaticResource Text}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,-40,-20,-60"/>
                    <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                        <TextBlock Text="ОСЕНЬ — ЗИМА 2026 · 15 МОДНЫХ ДОМОВ" Style="{StaticResource T.Eyebrow}"/>
                        <TextBlock x:Name="HeroTitle" Style="{StaticResource T.H1}" FontSize="52" Margin="0,12,0,16" LineHeight="56"/>
                        <TextBlock x:Name="HeroSubtitle" Style="{StaticResource T.Body}" FontSize="15" LineHeight="24"/>
                        <WrapPanel Margin="0,30,0,0">
                            <Button Content="Смотреть каталог" Style="{StaticResource Btn.Primary}" Tag="all" Click="Collection_Click" Margin="0,0,12,0"/>
                            <Button Content="Ресейл с экспертизой" Style="{StaticResource Btn.Ghost}" Tag="resale" Click="Collection_Click" Margin="0,0,12,0"/>
                            <Button Content="Скидки" Style="{StaticResource Btn.Ghost}" Tag="sale" Click="Collection_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <ItemsControl x:Name="StatsItems" Grid.Column="1" VerticalAlignment="Bottom" Margin="40,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="36,18,0,0">
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource FontDisplayBold}" FontSize="44" Foreground="{StaticResource Text}"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.Muted}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Новинки -->
            <DockPanel Margin="0,0,16,18">
                <Button DockPanel.Dock="Right" Content="Все новинки →" Style="{StaticResource Btn.Link}" Tag="new" Click="Collection_Click" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="НОВЫЙ СЕЗОН" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Новинки" Style="{StaticResource T.H2}"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="NewItems" ItemsPanel="{StaticResource Grid4}" ItemTemplate="{StaticResource ProductCardTemplate}"/>

            <!-- Модные дома -->
            <DockPanel Margin="0,28,16,18">
                <StackPanel>
                    <TextBlock Text="ИСТОРИЯ, ДИЗАЙНЕРЫ, КОЛЛЕКЦИИ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Модные дома" Style="{StaticResource T.H2}"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="BrandItems" ItemsPanel="{StaticResource Grid5}" ItemTemplate="{StaticResource BrandTile}" Margin="0,0,2,0"/>

            <!-- Культовые модели -->
            <DockPanel Margin="0,28,16,18">
                <Button DockPanel.Dock="Right" Content="Все культовые модели →" Style="{StaticResource Btn.Link}" Tag="iconic" Click="Collection_Click" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="ВЕЩИ, КОТОРЫЕ СТАЛИ СИМВОЛАМИ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Культовые модели" Style="{StaticResource T.H2}"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="IconicItems" ItemsPanel="{StaticResource Grid4}" ItemTemplate="{StaticResource ProductCardTemplate}"/>

            <!-- Скидки -->
            <DockPanel Margin="0,28,16,18">
                <Button DockPanel.Dock="Right" Content="Все скидки →" Style="{StaticResource Btn.Link}" Tag="sale" Click="Collection_Click" VerticalAlignment="Bottom"/>
                <StackPanel>
                    <TextBlock Text="ДО −30%" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Скидки" Style="{StaticResource T.H2}"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="SaleItems" ItemsPanel="{StaticResource Grid4}" ItemTemplate="{StaticResource ProductCardTemplate}"/>

            <TextBlock Text="AMFIBIA · лабораторная работа №28 · шаблон MVP · данные сайта Fashion_site" Style="{StaticResource T.Muted}"
                       FontSize="12" HorizontalAlignment="Center" Margin="0,28,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
