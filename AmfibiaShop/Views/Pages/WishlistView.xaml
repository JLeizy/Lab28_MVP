<UserControl x:Class="AmfibiaShop.Views.Pages.WishlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="44,30,28,48">
            <DockPanel Margin="0,0,16,26">
                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Очистить избранное" Style="{StaticResource Btn.Ghost}"
                        VerticalAlignment="Bottom" Click="ClearButton_Click"/>
                <StackPanel>
                    <TextBlock Text="ВЕЩИ, КОТОРЫЕ ВАМ ПОНРАВИЛИСЬ" Style="{StaticResource T.Eyebrow}"/>
                    <TextBlock Text="Избранное" Style="{StaticResource T.H1}" Margin="0,6,0,4"/>
                    <TextBlock x:Name="CountText" Style="{StaticResource T.Muted}"/>
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="Items" ItemsPanel="{StaticResource Grid4}" ItemTemplate="{StaticResource ProductCardTemplate}"/>

            <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="40,56" Margin="0,0,16,0" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="64" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="В избранном пока ничего нет" Style="{StaticResource T.H2}" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                    <TextBlock Text="Нажмите на сердечко на карточке, чтобы сохранить вещь." Style="{StaticResource T.Muted}" HorizontalAlignment="Center"/>
                    <Button Content="Перейти в каталог" Style="{StaticResource Btn.Primary}" Margin="0,24,0,0" HorizontalAlignment="Center"
                            Click="CatalogButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
