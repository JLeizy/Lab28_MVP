<UserControl x:Class="AmfibiaShop.Views.Pages.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaShop.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="44,30,44,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Товары -->
            <StackPanel>
                <DockPanel Margin="0,0,0,24">
                    <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="Очистить корзину" Style="{StaticResource Btn.Link}"
                            VerticalAlignment="Bottom" Click="ClearButton_Click"/>
                    <StackPanel>
                        <TextBlock Text="ВАШ ЗАКАЗ" Style="{StaticResource T.Eyebrow}"/>
                        <TextBlock Text="Корзина" Style="{StaticResource T.H1}" Margin="0,6,0,4"/>
                        <TextBlock x:Name="CountText" Style="{StaticResource T.Muted}"/>
                    </StackPanel>
                </DockPanel>

                <ItemsControl x:Name="LineItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" ClipToBounds="True" Height="124">
                                        <c:ProductArt Product="{Binding Product}" ShowWatermark="False"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="20,4,16,0">
                                        <TextBlock Text="{Binding Brand}" FontFamily="{StaticResource FontSemi}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        <Button Content="{Binding Name}" Style="{StaticResource Btn.Link}" Foreground="{StaticResource Text}" FontSize="16"
                                                FontFamily="{StaticResource FontMedium}" HorizontalAlignment="Left" Margin="0,4,0,0" Tag="{Binding Id}" Click="Open_Click"/>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource T.Muted}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,6,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsed}}"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="−" Style="{StaticResource Btn.Icon}" Width="38" Tag="{Binding Index}" IsEnabled="{Binding CanDecrease}" Click="Decrease_Click"/>
                                            <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontSemi}"/>
                                            <Button Content="+" Style="{StaticResource Btn.Icon}" Width="38" Tag="{Binding Index}" IsEnabled="{Binding CanIncrease}" Click="Increase_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Total}" Style="{StaticResource T.Price}" FontSize="18" HorizontalAlignment="Right"/>
                                        <TextBlock Style="{StaticResource T.Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Run Text="{Binding Price, Mode=OneWay}"/><Run Text=" за шт."/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="✕" Style="{StaticResource Btn.Icon}" Margin="14,0,0,0" VerticalAlignment="Center"
                                            ToolTip="Удалить" Tag="{Binding Index}" Click="Remove_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="40,56" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Корзина пуста" Style="{StaticResource T.H2}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выберите вещь и размер на странице товара." Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <Button Content="Перейти в каталог" Style="{StaticResource Btn.Primary}" Margin="0,24,0,0" HorizontalAlignment="Center" Click="Catalog_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Итоги -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,90,0,0">
                <StackPanel>
                    <TextBlock Text="Доставка" Style="{StaticResource T.H3}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="DeliveryPanel"/>

                    <TextBlock Text="Промокод" Style="{StaticResource T.H3}" Margin="0,16,0,12"/>
                    <DockPanel>
                        <Button x:Name="ApplyPromoButton" DockPanel.Dock="Right" Content="Применить" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0"
                                Click="ApplyPromo_Click"/>
                        <TextBox x:Name="PromoBox" Tag="AMFIBIA10" KeyDown="PromoBox_KeyDown"/>
                    </DockPanel>
                    <Border x:Name="PromoAppliedPanel" Background="{StaticResource AccentSoft}" CornerRadius="2" Padding="12,8" Margin="0,10,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Btn.Link}" ToolTip="Отменить промокод" Click="RemovePromo_Click"/>
                            <TextBlock x:Name="PromoAppliedText" Foreground="{StaticResource Accent}" FontFamily="{StaticResource FontSemi}" FontSize="13"/>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Divider}" Margin="0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SummaryCount" Style="{StaticResource T.Muted}"/>
                        <TextBlock x:Name="SubtotalText" Grid.Column="1" Foreground="{StaticResource Text}"/>
                        <TextBlock Grid.Row="1" Text="Скидка" Style="{StaticResource T.Muted}" Margin="0,8,0,0" x:Name="DiscountLabel"/>
                        <TextBlock x:Name="DiscountText" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Text="Доставка" Style="{StaticResource T.Muted}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="DeliveryText" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Text}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Text="Итого" FontFamily="{StaticResource FontDisplayBold}" FontSize="26" Margin="0,14,0,0"/>
                        <TextBlock x:Name="TotalText" Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource FontDisplayBold}" FontSize="26" Margin="0,14,0,0"/>
                    </Grid>

                    <ProgressBar x:Name="FreeDeliveryBar" Style="{StaticResource Progress.Thin}" Maximum="1" Margin="0,18,0,8"/>
                    <TextBlock x:Name="FreeDeliveryText" Style="{StaticResource T.Muted}" FontSize="12"/>

                    <Button x:Name="CheckoutButton" Content="Оформить заказ" Style="{StaticResource Btn.Primary}" Padding="20,14" Margin="0,22,0,0"
                            Click="Checkout_Click"/>
                    <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <TextBlock Text="✓ Подлинность каждой вещи проверена экспертами AMFIBIA" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
