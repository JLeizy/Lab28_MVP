<Window x:Class="AmfibiaShop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMFIBIA — вход"
        Width="420" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Language="ru-RU"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource PaperBrush}"
        FocusManager.FocusedElement="{Binding ElementName=EmailTextBox}">

    <StackPanel>
        <!-- Шапка -->
        <Border Background="{StaticResource InkBrush}" Padding="24,22">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="AMFIBIA" FontFamily="{StaticResource DisplayFont}" FontSize="32"
                           Foreground="{StaticResource CreamBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="маркетплейс брендовой одежды" FontSize="12"
                           Foreground="#8A857D" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Background="{StaticResource AccentBrush}" Height="3"/>

        <!-- Форма входа -->
        <StackPanel Margin="28,22,28,24">
            <TextBlock Text="Вход в аккаунт" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                       Foreground="{StaticResource InkBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="Email" Style="{StaticResource Caption}"/>
            <TextBox Name="EmailTextBox"/>

            <TextBlock Text="Пароль" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
            <PasswordBox Name="PassBox"/>

            <Button Name="LoginButton" Content="Войти" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                    Click="LoginButton_Click"/>

            <TextBlock Name="MessageBlock" Foreground="{StaticResource ErrorBrush}"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

            <!-- Подсказка для демонстрации -->
            <Border Background="{StaticResource SoftBrush}" Padding="12,10" Margin="0,18,0,0">
                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                    Тестовые аккаунты сайта: buyer@amfibia.by, owner@amfibia.by,
                    blocked.user@example.com. Пароль у всех: Amfibia2026
                </TextBlock>
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
