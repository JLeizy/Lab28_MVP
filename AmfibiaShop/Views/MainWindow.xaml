<Window x:Class="AmfibiaShop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMFIBIA — маркетплейс брендовой одежды"
        Width="1440" Height="900" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource FontBody}" Foreground="{StaticResource Text}"
        Language="ru-RU">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== ШАПКА ===================== -->
        <Border Background="{StaticResource Bg}" Padding="28,8,28,0">
            <DockPanel LastChildFill="True">
                <!-- Слева: назад и логотип -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,36,6">
                    <Button x:Name="BackButton" Content="←" Style="{StaticResource Btn.Icon}" ToolTip="Назад"
                            Visibility="Collapsed" Margin="0,0,8,0" Click="BackButton_Click"/>
                    <Button x:Name="LogoButton" Click="LogoButton_Click" Cursor="Hand" ToolTip="Главная">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock Text="AMFIBIA" FontFamily="{StaticResource FontLogo}" FontSize="32"
                                           Foreground="{StaticResource Text}" Background="Transparent"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Справа: поиск, валюта, счётчики, профиль -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBox x:Name="SearchBox" Width="250" Tag="Поиск: Triple S, Prada, кольцо…" KeyDown="SearchBox_KeyDown"
                             VerticalAlignment="Center" Padding="12,8"/>
                    <ComboBox x:Name="CurrencyBox" Width="96" Margin="12,0,18,0" SelectionChanged="CurrencyBox_SelectionChanged"
                              ToolTip="Валюта цен" Padding="12,8,30,8"/>

                    <RadioButton x:Name="NavWishlist" GroupName="Nav" Style="{StaticResource NavTab}" Tag="wishlist" Checked="Nav_Checked" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♡" FontFamily="Segoe UI Symbol" FontSize="17" VerticalAlignment="Center"/>
                            <TextBlock Text="Избранное" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Border x:Name="WishlistBadge" Style="{StaticResource CounterBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="WishlistCount" FontSize="11" FontFamily="{StaticResource FontSemi}" Foreground="{StaticResource Bg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCompare" GroupName="Nav" Style="{StaticResource NavTab}" Tag="compare" Checked="Nav_Checked" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇄" FontFamily="Segoe UI Symbol" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Сравнение" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Border x:Name="CompareBadge" Style="{StaticResource CounterBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="CompareCount" FontSize="11" FontFamily="{StaticResource FontSemi}" Foreground="{StaticResource Bg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavCart" GroupName="Nav" Style="{StaticResource NavTab}" Tag="cart" Checked="Nav_Checked" Margin="0,0,22,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛍" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Корзина" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <Border x:Name="CartBadge" Style="{StaticResource CounterBadge}" Visibility="Collapsed">
                                <TextBlock x:Name="CartCount" FontSize="11" FontFamily="{StaticResource FontSemi}" Foreground="{StaticResource Bg}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <!-- Профиль -->
                    <RadioButton x:Name="NavProfile" GroupName="Nav" Tag="profile" Checked="Nav_Checked" Cursor="Hand" ToolTip="Профиль"
                                 FocusVisualStyle="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Background="Transparent">
                                    <ContentPresenter/>
                                </Grid>
                            </ControlTemplate>
                        </RadioButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="AvatarBorder" Width="38" Height="38" CornerRadius="19" Background="{StaticResource Surface3}"
                                    BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
                                <TextBlock x:Name="InitialsText" FontFamily="{StaticResource FontDisplayBold}" FontSize="17"
                                           Foreground="{StaticResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" FontFamily="{StaticResource FontMedium}" FontSize="13" Foreground="{StaticResource Text}"/>
                                <TextBlock x:Name="UserRoleText" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Центр: разделы -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <RadioButton x:Name="NavHome" GroupName="Nav" Content="Главная" Style="{StaticResource NavTab}" Tag="home" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavCatalog" GroupName="Nav" Content="Каталог" Style="{StaticResource NavTab}" Tag="catalog" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavBrands" GroupName="Nav" Content="Модные дома" Style="{StaticResource NavTab}" Tag="brands" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavOrders" GroupName="Nav" Content="Мои заказы" Style="{StaticResource NavTab}" Tag="orders" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Height="1" Background="{StaticResource Line}"/>

        <!-- ===================== СТРАНИЦА ===================== -->
        <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False"/>

        <!-- Всплывающее уведомление -->
        <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                Background="{StaticResource Surface3}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="3"
                Padding="18,14" MaxWidth="440" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="ToastMark" Width="4" CornerRadius="2" Background="{StaticResource Success}" Margin="0,0,14,0"/>
                <TextBlock x:Name="ToastText" Foreground="{StaticResource Text}" FontSize="13" TextWrapping="Wrap" MaxWidth="380"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
