<UserControl x:Class="AmfibiaShop.Views.Controls.ProductCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:AmfibiaShop.Views.Controls"
             Margin="0,0,16,20">
    <!-- DataContext — ProductCardData (готовые данные от Представителя) -->
    <Border x:Name="Root" Background="{StaticResource Surface}" BorderThickness="1"
            CornerRadius="3" Cursor="Hand" MouseLeftButtonUp="Root_MouseLeftButtonUp" RenderTransformOrigin="0.5,0.5"
            ToolTip="{Binding Name}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Lift" Y="0"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <c:ProductArt Product="{Binding Product}"/>
            <Border Style="{StaticResource Badge}" Margin="12">
                <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}"/>
            </Border>
            <Button x:Name="HeartButton" Style="{StaticResource Btn.Heart}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="10" Click="HeartButton_Click" ToolTip="Избранное">
                <TextBlock x:Name="HeartGlyph">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="♡"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Text" Value="♥"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <StackPanel Grid.Row="1" Margin="16,14,16,16">
                <TextBlock Text="{Binding Brand}" FontFamily="{StaticResource FontSemi}" FontSize="11" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource FontMedium}" FontSize="14" Foreground="{StaticResource Text}"
                           Margin="0,6,0,0" Height="40" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Category}" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,2,0,10"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Rating}" Foreground="{StaticResource Gold}" FontSize="12"
                               FontFamily="{StaticResource FontMedium}" VerticalAlignment="Center"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Price}" Style="{StaticResource T.Price}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding OldPrice}" Style="{StaticResource T.Muted}" TextDecorations="Strikethrough"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
