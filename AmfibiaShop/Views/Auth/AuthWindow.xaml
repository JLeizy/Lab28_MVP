<Window x:Class="AmfibiaShop.Views.Auth.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="clr-namespace:AmfibiaShop.Views.Auth"
        Title="AMFIBIA — вход"
        Width="1120" Height="720" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource FontBody}" Foreground="{StaticResource Text}"
        Language="ru-RU">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: витрина бренда -->
        <Border Background="{StaticResource HeroGradient}" ClipToBounds="True">
            <Grid Margin="56,52">
                <TextBlock Text="A" FontFamily="{StaticResource FontLogo}" FontSize="620" Foreground="{StaticResource Text}"
                           Opacity="0.035" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-170"/>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="AMFIBIA" FontFamily="{StaticResource FontLogo}" FontSize="64" Foreground="{StaticResource Text}"/>
                    <TextBlock Text="МАРКЕТПЛЕЙС БРЕНДОВОЙ ОДЕЖДЫ" Style="{StaticResource T.Eyebrow}" Margin="4,4,0,0"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="Высокая мода и готика." Style="{StaticResource T.H1}" FontSize="40"/>
                    <TextBlock Text="Пятнадцать модных домов — от Balenciaga до Chrome Hearts. Новые вещи и подлинный ресейл с экспертизой."
                               Style="{StaticResource T.Body}" Margin="0,12,0,28" MaxWidth="460" HorizontalAlignment="Left"/>
                    <WrapPanel>
                        <TextBlock Text="Balenciaga · Vetements · Gucci · Prada · Enfants Riches Déprimés · AVAVAV · Supreme · Chrome Hearts · Louis Vuitton · Chanel · Maison Margiela · Givenchy · Versace · Alexander McQueen · Loro Piana"
                                   Style="{StaticResource T.Muted}" FontSize="12" MaxWidth="480" LineHeight="20"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая часть: форма входа или регистрации -->
        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <Grid Margin="64,0" VerticalAlignment="Center">
                <a:LoginView x:Name="LoginPanel"/>
                <a:RegisterView x:Name="RegisterPanel" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
