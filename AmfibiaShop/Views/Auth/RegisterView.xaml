<UserControl x:Class="AmfibiaShop.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="440">
        <TextBlock Text="НОВЫЙ ПОКУПАТЕЛЬ" Style="{StaticResource T.Eyebrow}"/>
        <TextBlock Text="Создать аккаунт" Style="{StaticResource T.H1}" FontSize="38" Margin="0,6,0,20"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Имя" Style="{StaticResource T.Label}"/>
                <TextBox x:Name="FirstNameBox"/>
                <TextBlock x:Name="FirstNameError" Style="{StaticResource T.Error}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Фамилия" Style="{StaticResource T.Label}"/>
                <TextBox x:Name="LastNameBox"/>
                <TextBlock x:Name="LastNameError" Style="{StaticResource T.Error}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Email" Style="{StaticResource T.Label}" Margin="0,12,0,6"/>
        <TextBox x:Name="EmailBox" Tag="name@example.com"/>
        <TextBlock x:Name="EmailError" Style="{StaticResource T.Error}"/>

        <TextBlock Text="Телефон" Style="{StaticResource T.Label}" Margin="0,12,0,6"/>
        <TextBox x:Name="PhoneBox" Tag="+375 29 123-45-67"/>
        <TextBlock x:Name="PhoneError" Style="{StaticResource T.Error}"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Пароль" Style="{StaticResource T.Label}"/>
                <PasswordBox x:Name="PasswordBox1"/>
                <TextBlock x:Name="PasswordError" Style="{StaticResource T.Error}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Повторите пароль" Style="{StaticResource T.Label}"/>
                <PasswordBox x:Name="PasswordBox2"/>
                <TextBlock x:Name="PasswordRepeatError" Style="{StaticResource T.Error}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="Не короче 8 символов, буквы и цифры." Style="{StaticResource T.Muted}" FontSize="12" Margin="0,6,0,0"/>

        <CheckBox x:Name="AgreeBox" Content="Согласен с условиями магазина и обработкой данных" Margin="0,16,0,0"/>
        <TextBlock x:Name="AgreedError" Style="{StaticResource T.Error}"/>

        <Button x:Name="CreateButton" Content="Создать аккаунт" Style="{StaticResource Btn.Primary}" IsDefault="True"
                Margin="0,20,0,0" Click="CreateButton_Click"/>
        <TextBlock x:Name="MessageBlock" Style="{StaticResource T.Error}" FontSize="13" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="Уже есть аккаунт?" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
            <Button Content="Войти" Style="{StaticResource Btn.Link}" Margin="8,0,0,0" Click="LoginLink_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
