<Window x:Class="AmfibiaShop.Views.ShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMFIBIA — каталог и корзина"
        Width="1300" Height="760" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Language="ru-RU"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource PaperBrush}"
        FocusManager.FocusedElement="{Binding ElementName=SearchTextBox}">

    <DockPanel>
        <!-- Шапка: логотип и пользователь -->
        <Border DockPanel.Dock="Top" Background="{StaticResource InkBrush}" Padding="24,14">
            <DockPanel>
                <TextBlock Name="UserTextBlock" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource CreamBrush}" FontSize="13"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="AMFIBIA" FontFamily="{StaticResource DisplayFont}" FontSize="28"
                               Foreground="{StaticResource CreamBrush}"/>
                    <TextBlock Text="каталог 15 модных домов" Foreground="#8A857D" FontSize="12"
                               VerticalAlignment="Bottom" Margin="14,0,0,6"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBrush}" Height="3"/>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Каталог ===== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Фильтры -->
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Поиск по названию, бренду или категории" Style="{StaticResource Caption}"/>
                            <TextBox Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Бренд" Style="{StaticResource Caption}"/>
                            <ComboBox Name="BrandComboBox" Padding="6,6"
                                      SelectionChanged="FilterComboBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Раздел" Style="{StaticResource Caption}"/>
                            <ComboBox Name="GroupComboBox" Padding="6,6"
                                      SelectionChanged="FilterComboBox_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Сортировка" Style="{StaticResource Caption}"/>
                            <ComboBox Name="SortComboBox" Padding="6,6"
                                      SelectionChanged="FilterComboBox_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Name="CountTextBlock" DockPanel.Dock="Top" Margin="0,12,0,8"
                               Foreground="{StaticResource MutedBrush}"/>

                    <!-- Список товаров -->
                    <ListView Name="ProductsListView" BorderBrush="{StaticResource LineBrush}"
                              SelectionMode="Single"
                              SelectionChanged="ProductsListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Бренд" Width="130"
                                                DisplayMemberBinding="{Binding Brand}"/>
                                <GridViewColumn Header="Товар" Width="290"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Категория" Width="120"
                                                DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Цвет" Width="105"
                                                DisplayMemberBinding="{Binding Color}"/>
                                <GridViewColumn Header="Состояние" Width="80"
                                                DisplayMemberBinding="{Binding Condition}"/>
                                <GridViewColumn Header="Цена" Width="95"
                                                DisplayMemberBinding="{Binding Price, StringFormat={}{0:N0} BYN}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ===== Правая колонка: карточка товара и корзина ===== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Карточка товара -->
                <Border Grid.Row="0" Style="{StaticResource Card}" MinHeight="250">
                    <Grid>
                        <TextBlock Name="ProductHintTextBlock" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Выберите товар в каталоге, чтобы увидеть описание и размеры"/>

                        <StackPanel Name="ProductPanel" Visibility="Collapsed">
                            <TextBlock Name="BrandTextBlock" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Name="NameTextBlock" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                                       TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <TextBlock Name="DetailsTextBlock" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}" LineHeight="18"/>

                            <TextBlock Text="Размер" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                            <ListBox Name="SizesListBox" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource SizeChip}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <!-- Цена и кнопка в одной строке -->
                            <DockPanel Margin="0,4,0,0">
                                <Button Name="AddToCartButton" DockPanel.Dock="Right" Content="В корзину"
                                        Style="{StaticResource PrimaryButton}" Click="AddToCartButton_Click"/>
                                <TextBlock Name="PriceTextBlock" FontSize="20" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Корзина -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Name="RemoveButton" DockPanel.Dock="Right" Content="Удалить"
                                    ToolTip="Удалить выбранный в корзине товар"
                                    Style="{StaticResource OutlineButton}" Padding="10,3"
                                    Click="RemoveButton_Click"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Корзина" FontFamily="{StaticResource DisplayFont}" FontSize="20"/>
                                <TextBlock Name="CartCountTextBlock" VerticalAlignment="Bottom" Margin="10,0,0,3"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Низ корзины: промокод, суммы, сообщения -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <DockPanel>
                                <Button Name="ApplyPromoButton" DockPanel.Dock="Right" Content="Применить"
                                        Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                                        Click="ApplyPromoButton_Click"/>
                                <TextBox Name="PromoTextBox" ToolTip="Промокод, например AMFIBIA10"
                                         KeyDown="PromoTextBox_KeyDown"/>
                            </DockPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Сумма" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Name="SubtotalTextBlock" TextAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="Скидка" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="DiscountTextBlock" TextAlignment="Right"
                                           Margin="12,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Text="Итого" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Name="TotalTextBlock" TextAlignment="Right"
                                           FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </Grid>

                            <TextBlock Name="CartMessageTextBlock" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Товары в корзине -->
                        <ListView Name="CartListView" BorderBrush="{StaticResource LineBrush}" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Товар" Width="150"
                                                    DisplayMemberBinding="{Binding Product.Name}"/>
                                    <GridViewColumn Header="Размер" Width="58"
                                                    DisplayMemberBinding="{Binding Size}"/>
                                    <GridViewColumn Header="Шт." Width="40"
                                                    DisplayMemberBinding="{Binding Quantity}"/>
                                    <GridViewColumn Header="Сумма" Width="85"
                                                    DisplayMemberBinding="{Binding Total, StringFormat={}{0:N0} BYN}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
